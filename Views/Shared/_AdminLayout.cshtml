<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | TravelSphere</title>
    <link rel="stylesheet" href="~/css/App.css"            asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Home.css"           asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="home">

        <!-- ── Admin Sidebar ──────────────────────────────────────── -->
        <div class="sidebar">
            <div class="sidebar-top">
                <h2 class="logo">TravelSphere</h2>
                <p class="tagline">Admin Control Panel</p>

                <ul class="menu">

                    <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <a href="@Url.Action("Index", "Admin")">
                            <i class="fa-solid fa-gauge"></i> Dashboard
                        </a>
                    </li>

                    <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() is "Packages" or "AddPackage" ? "active" : "")">
                        <a href="@Url.Action("Packages", "Admin")">
                            <i class="fa-solid fa-box-open"></i> Packages
                        </a>
                    </li>

                    <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Bookings" ? "active" : "")">
                        <a href="@Url.Action("Bookings", "Admin")">
                            <i class="fa-solid fa-calendar-check"></i> Bookings
                        </a>
                    </li>

                    <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "About" ? "active" : "")">
                        <a href="@Url.Action("About", "Admin")">
                            <i class="fa-solid fa-circle-info"></i> About Us
                        </a>
                    </li>

                    <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() is "Profile" or "EditProfile" ? "active" : "")">
                        <a href="@Url.Action("Profile", "Admin")">
                            <i class="fa-solid fa-user-tie"></i> Profile
                        </a>
                    </li>

                </ul>
            </div>

            <div class="logout-container">
                <div class="logout" onclick="location.href='@Url.Action("Logout", "Account")'">
                    <i class="fa-solid fa-right-from-bracket"></i> Log Out
                </div>
            </div>
        </div>

        <!-- ── Main Content ───────────────────────────────────────── -->
        <div class="main">
            @RenderBody()
        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
