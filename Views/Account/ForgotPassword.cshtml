@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ForgotPassword.css" />
}

<div class="forgot-container">
    <div class="forgot-box">
        <h2 class="title" style="text-align: center; margin-bottom: 25px; font-weight: bold;">Reset Password</h2>
        
        @if (ViewBag.Error != null)
        {
            <div style="color: red; text-align: center; margin-bottom: 10px;">@ViewBag.Error</div>
        }

        <form asp-action="ForgotPassword" method="post">
            <div class="input-group">
                <label style="display: block; margin-bottom: 8px;">Enter Registered Email:</label>
                <input type="email" name="email" placeholder="Enter your email" required />
            </div>

            <button type="submit" class="forgot-btn">Send Reset Link</button>
        </form>

        <div class="back-to-login">
            Remembered your password?
            <span onclick="location.href='@Url.Action("Login", "Account")'">Login</span>
        </div>
    </div>
</div>
