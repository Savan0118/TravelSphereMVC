@model IEnumerable<TravelSphereMVC.Models.WishlistItem>
@using System.Security.Claims
@inject TravelSphereMVC.Models.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "My Wishlist";
    var userId     = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var profileImg = DbContext.Users.Find(userId)?.ProfileImageUrl
                     ?? "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png";
}

@section Styles {
    <link rel="stylesheet" href="~/css/MyJourneys.css" />
}

<!-- BANNER -->
<div class="banner">
    <div class="banner-text">
        <h1>My Wishlist</h1>
        <p>Your saved travel packages — ready when you are</p>
    </div>
    <img src="@profileImg" class="profile"
         onclick="location.href='@Url.Action("Profile", "Account")'"
         style="cursor: pointer; background: white; border-radius: 50%; width: 50px; height: 50px; object-fit: cover; border: none; padding: 2px;" />
</div>

<div class="content-area">
    <h2 class="section-title" style="margin-bottom: 25px;">Saved Packages</h2>

    @if (TempData["WishlistMessage"] != null)
    {
        <p style="background: #e8f5e9; color: #2e7d32; padding: 10px 16px; border-radius: 8px; margin-bottom: 16px;">
            @TempData["WishlistMessage"]
        </p>
    }

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 60px 20px; color: #888;">
            <i class="fa-solid fa-heart" style="font-size: 48px; color: #ddd; margin-bottom: 16px;"></i>
            <p style="font-size: 18px; margin: 0;">Your wishlist is empty.</p>
            <p style="font-size: 14px; margin-top: 8px;">Explore packages and add your favourites!</p>
            <button onclick="location.href='@Url.Action("Packages", "Home")'"
                    style="margin-top: 20px; padding: 10px 24px; background: #2ecc71; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px;">
                Explore Packages
            </button>
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="trip-card premium">
                <div class="trip-image">
                    <img src="@(item.Package?.ImageUrl ?? "/Images/placeholder.png")"
                         alt="@item.Package?.Name"
                         onerror="this.src='https://placehold.co/400x200'" />
                </div>
                <div class="trip-info">
                    <div class="trip-top">
                        <h3>@item.Package?.Name</h3>
                        <span class="status upcoming">Wishlisted</span>
                    </div>

                    <p class="date">Added: @item.AddedAt.ToString("dd MMM yyyy")</p>
                    <p class="location">📍 @item.Package?.Location</p>

                    <div class="trip-meta">
                        <span class="meta">⏳ @item.Package?.Duration</span>
                        <span class="meta">💰 ₹@item.Package?.Price.ToString("N0")</span>
                    </div>

                    <div style="display: flex; gap: 10px; margin-top: 12px;">
                        <button class="view-btn"
                                onclick="location.href='@Url.Action("Description", "Home", new { id = item.PackageId })'">
                            View Details
                        </button>
                        <form asp-controller="Wishlist" asp-action="Remove" method="post" style="margin:0;">
                            <input type="hidden" name="packageId"  value="@item.PackageId" />
                            <input type="hidden" name="returnUrl"  value="@Url.Action("Index", "Wishlist")" />
                            <button type="submit"
                                    style="padding: 8px 16px; background: #e74c3c; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 13px;">
                                Remove
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
