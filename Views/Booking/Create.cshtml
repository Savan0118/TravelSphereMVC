@{
    ViewData["Title"] = "Booking";
    var packageData = ViewBag.Package as TravelSphereMVC.Models.Package;
    if (packageData == null) { Context.Response.Redirect("/Home/Packages"); return; }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Booking.css" />
}

<!-- BANNER -->
<div class="banner booking-banner" style="background-image:url('@packageData!.ImageUrl'); background-size:cover; background-position:center; min-height:180px; max-height:180px;">
    <div class="banner-overlay"></div>
    <div class="banner-text" style="padding:40px;">
        <h1 style="color:white; margin:0; text-shadow:0 2px 8px rgba(0,0,0,0.4);">@packageData!.Name</h1>
        <p style="color:rgba(255,255,255,0.9); margin:4px 0 0;">📍 @packageData.Location &nbsp;|&nbsp; ⏳ @packageData.Duration</p>
    </div>
</div>

<div class="content-area booking-layout">
    <!-- ── LEFT ─────────────────────────────────────────────────── -->
    <div class="booking-left">
        <form asp-action="Create" asp-controller="Booking" method="post" id="bookingForm">
            <input type="hidden" name="packageId"   value="@packageData!.Id" />
            <input type="hidden" name="totalAmount"  id="hiddenTotal" value="@packageData!.Price" />

            <div class="booking-card glass">
                <h2 class="section-title">Contact Details</h2>
                <div class="profile-box">
                    <div>
                        <strong>@User.Identity?.Name</strong>
                        <p>@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value</p>
                    </div>
                </div>

                <h3 class="sub-title" style="margin-top:20px;">Traveller Details</h3>

                <div class="counter">
                    <button type="button" onclick="removeTraveller()">−</button>
                    <span id="travellerCount">1</span>
                    <span style="font-size:13px; color:#666;">Travellers</span>
                    <button type="button" onclick="addTraveller()">+</button>
                </div>

                <!-- Traveller summary badges -->
                <div id="summaryBadges" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
                    <span class="meta" id="adultBadge">1 Adult</span>
                    <span class="meta" id="childBadge" style="display:none;"></span>
                </div>

                <div id="travellersContainer">
                    <div class="traveller-entry" id="traveller-1">
                        <div class="traveller-row-header">
                            <span style="font-weight:700; font-size:13px; color:#555;">Traveller 1</span>
                        </div>
                        <div class="traveller-box">
                            <input type="text"   name="travellerNames" placeholder="Full Name" required />
                            <input type="number" name="travellerAges"  placeholder="Age" required min="1" max="100" oninput="updateBadges()" />
                            <select name="travellerTypes" class="traveller-type-select" onchange="updateBadges()">
                                <option value="Adult">Adult</option>
                                <option value="Child">Child</option>
                            </select>
                        </div>
                    </div>
                </div>

                <textarea name="SpecialRequests" placeholder="📝 Special requests (optional)" style="margin-top:16px; width:100%; box-sizing:border-box;"></textarea>

                <div class="note-box" style="margin-top:12px;">
                    ⚠️ This is a booking request. Our team will contact you to confirm.
                </div>

                <button type="submit" class="confirm-btn" style="margin-top:16px;">
                    🔒 Send Booking Request
                </button>
            </div>
        </form>
    </div>

    <!-- ── RIGHT ────────────────────────────────────────────────── -->
    <div class="booking-right">
        <div class="summary-card glass">
            <h3 class="section-title">Booking Summary</h3>
            <p><strong>Package :</strong> @packageData!.Name</p>
            <p><strong>Location :</strong> @packageData!.Location</p>
            <p><strong>Duration :</strong> @packageData!.Duration</p>
            @if (!string.IsNullOrEmpty(packageData.MealsIncluded))
            { <p><strong>Meals :</strong> @packageData.MealsIncluded</p> }
            @if (!string.IsNullOrEmpty(packageData.HotelName))
            { <p><strong>Hotel :</strong> @packageData.HotelName</p> }
            <hr />
            <p><strong>Price/Person :</strong> ₹ @packageData!.Price.ToString("N0")</p>
            <p><strong>Travellers :</strong> <span id="summaryCount">1</span></p>
            <p style="font-size:12px; color:#888;"><span id="adultSummary">1 Adult</span></p>

            <div class="price-box">₹ <span id="totalPrice">@packageData!.Price.ToString("N0")</span></div>

            <div class="seat-box @(packageData.TotalSeats < 5 ? "low" : "")">
                @if (packageData.TotalSeats > 0)
                {
                    @(packageData.TotalSeats < 5 ? $"⚠ Only {packageData.TotalSeats} seats left!" : $"✓ {packageData.TotalSeats} seats available")
                }
            </div>

            <div class="trust">
                🔒 Secure Booking &nbsp; 📞 Verified Partner &nbsp; ⭐ Trusted Experience
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let count = 1;
    const pricePerPerson = @packageData!.Price;

    function updateBadges() {
        const types = document.querySelectorAll('[name="travellerTypes"]');
        let adults = 0, children = 0;
        types.forEach(s => s.value === 'Child' ? children++ : adults++);
        document.getElementById('adultBadge').textContent  = adults   + ' Adult'  + (adults   !== 1 ? 's' : '');
        document.getElementById('childBadge').textContent  = children + ' Child'  + (children !== 1 ? 'ren' : '');
        document.getElementById('childBadge').style.display = children > 0 ? '' : 'none';
        document.getElementById('adultSummary').textContent = adults + ' Adult' + (adults !== 1 ? 's' : '') +
            (children > 0 ? ', ' + children + ' Child' + (children !== 1 ? 'ren' : '') : '');
    }

    function updateUI() {
        document.getElementById('travellerCount').innerText = count;
        document.getElementById('summaryCount').innerText   = count;
        const total = count * pricePerPerson;
        document.getElementById('totalPrice').innerText  = total.toLocaleString('en-IN');
        document.getElementById('hiddenTotal').value     = total;
        updateBadges();
    }

    function addTraveller() {
        if (count >= 15) return;
        count++;
        const container = document.getElementById('travellersContainer');
        const div = document.createElement('div');
        div.className = 'traveller-entry';
        div.id = 'traveller-' + count;
        div.innerHTML = `
            <div class="traveller-row-header">
                <span style="font-weight:700;font-size:13px;color:#555;">Traveller ${count}</span>
            </div>
            <div class="traveller-box">
                <input type="text"   name="travellerNames" placeholder="Full Name" required />
                <input type="number" name="travellerAges"  placeholder="Age" required min="1" max="100" oninput="updateBadges()" />
                <select name="travellerTypes" class="traveller-type-select" onchange="updateBadges()">
                    <option value="Adult">Adult</option>
                    <option value="Child">Child</option>
                </select>
            </div>`;
        container.appendChild(div);
        updateUI();
    }

    function removeTraveller() {
        if (count <= 1) return;
        document.getElementById('traveller-' + count)?.remove();
        count--;
        updateUI();
    }
</script>
}
