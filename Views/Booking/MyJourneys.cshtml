@model IEnumerable<TravelSphereMVC.Models.Booking>
@using System.Security.Claims
@inject TravelSphereMVC.Models.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "My Journeys";
    var userId     = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var profileImg = DbContext.Users.Find(userId)?.ProfileImageUrl
                     ?? "https://ui-avatars.com/api/?name=T&background=2a8153&color=fff";
}

@section Styles {
    <link rel="stylesheet" href="~/css/MyJourneys.css" />
}

<!-- BANNER -->
<div class="banner">
    <div class="banner-text">
        <h1>My Journeys</h1>
        <p>Track all your booked travel experiences</p>
    </div>
    <img src="@profileImg" class="profile"
         onclick="location.href='@Url.Action("Profile","Account")'"
         style="cursor:pointer; border-radius:50%; width:50px; height:50px; object-fit:cover; border:2px solid white;" />
</div>

<div class="content-area">
    <h2 class="section-title" style="margin-bottom:24px;">My Trips</h2>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:70px 20px; color:#888;">
            <i class="fa-solid fa-map-location-dot" style="font-size:56px; color:#ddd; display:block; margin-bottom:16px;"></i>
            <h3 style="font-size:20px; color:#555; margin:0 0 8px;">No journeys yet</h3>
            <p style="font-size:14px; margin:0 0 20px;">Start exploring and book your first adventure!</p>
            <button onclick="location.href='@Url.Action("Packages","Home")'"
                    style="background:linear-gradient(135deg,#2a8153,#1a4f36); color:white; border:none; padding:12px 30px; border-radius:25px; font-size:14px; font-weight:600; cursor:pointer;">
                Explore Packages
            </button>
        </div>
    }
    else
    {
        @foreach (var booking in Model)
        {
            var adults   = booking.Travellers.Count(t => t.Age >= 18 || t.TravellerType == "Adult");
            var children = booking.Travellers.Count(t => t.TravellerType == "Child" || (t.TravellerType == "Adult" ? false : t.Age < 18 && t.Age > 0));

            <div class="trip-card premium">
                <div class="trip-image">
                    <img src="@(booking.Package?.ImageUrl ?? "/Images/placeholder.png")"
                         alt="@booking.Package?.Name"
                         onerror="this.src='https://placehold.co/250x200/2a8153/white?text=Travel'" />
                </div>
                <div class="trip-info">
                    <div class="trip-top">
                        <h3>@booking.Package?.Name</h3>
                        @if (booking.Status == "Confirmed")
                        {
                            <span class="status" style="background:#27ae60; color:white; padding:4px 14px; border-radius:20px; font-size:11px; font-weight:700;">✓ Confirmed</span>
                        }
                        else if (booking.Status == "Pending")
                        {
                            <span class="status" style="background:#f39c12; color:#fff; padding:4px 14px; border-radius:20px; font-size:11px; font-weight:700;">⏳ Pending</span>
                        }
                        else
                        {
                            <span class="status" style="background:#e74c3c; color:white; padding:4px 14px; border-radius:20px; font-size:11px; font-weight:700;">✕ @booking.Status</span>
                        }
                    </div>

                    <p class="date">📅 Booked: @booking.Timestamp.ToString("dd MMM yyyy")</p>
                    <p class="location">📍 @booking.Package?.Location</p>

                    <div class="trip-meta">
                        <span class="meta">⏳ @booking.Package?.Duration</span>
                        <span class="meta">👥 @booking.Travellers.Count Traveller@(booking.Travellers.Count!=1?"s":"")</span>
                        <span class="meta">💰 ₹@booking.TotalAmount.ToString("N0")</span>
                    </div>

                    <button class="view-btn"
                            onclick="location.href='@Url.Action("TripDetails","Booking",new{id=booking.Id})'">
                        View Details
                    </button>
                </div>
            </div>
        }
    }
</div>
