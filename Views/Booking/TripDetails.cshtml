@model TravelSphereMVC.Models.Booking
@using System.Security.Claims
@inject TravelSphereMVC.Models.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Trip Details";
    var userId     = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var profileImg = DbContext.Users.Find(userId)?.ProfileImageUrl
                     ?? "https://ui-avatars.com/api/?name=T&background=2a8153&color=fff";
    bool canReview = (bool)(ViewBag.CanReview ?? false);
}

@section Styles {
    <link rel="stylesheet" href="~/css/TripDetails.css" />
    <link rel="stylesheet" href="~/css/Description.css" />
}

@if (Model == null)
{
    <h2 style="padding:40px;">Trip not found.</h2>
}
else
{
    <!-- BANNER -->
    <div class="banner" style="background-image:url('@(Model.Package?.ImageUrl ?? "/Images/placeholder.png")'); background-size:cover; background-position:center; min-height:220px; max-height:220px;">
        <div class="banner-overlay"></div>
        <div class="banner-text" style="padding:40px;">
            <h1 style="color:white; margin:0; text-shadow:0 2px 10px rgba(0,0,0,0.4);">@Model.Package?.Name</h1>
            <p style="color:rgba(255,255,255,0.9); margin:6px 0 0;">📍 @Model.Package?.Location &nbsp;|&nbsp; ⏳ @Model.Package?.Duration</p>
        </div>
        <img src="@profileImg" class="profile"
             style="border-radius:50%; width:50px; height:50px; object-fit:cover; border:2px solid white; position:absolute; top:24px; right:28px; z-index:3;" />
    </div>

    <div class="content-area" style="display:flex; gap:28px;">

        <!-- ── LEFT ──────────────────────────────────────────────── -->
        <div style="flex:2; display:flex; flex-direction:column; gap:20px;">

            <!-- STATUS CARD -->
            <div class="trip-card-detail" style="display:flex; align-items:center; justify-content:space-between; padding:22px 28px;">
                <div>
                    <div style="font-size:13px; color:#888; margin-bottom:4px;">Booking Status</div>
                    @if (Model.Status == "Confirmed")
                    {
                        <span style="background:#e8f5e9; color:#1b5e20; padding:8px 20px; border-radius:20px; font-size:14px; font-weight:700;">✓ Confirmed</span>
                    }
                    else if (Model.Status == "Pending")
                    {
                        <span style="background:#fff8e1; color:#e65100; padding:8px 20px; border-radius:20px; font-size:14px; font-weight:700;">⏳ Pending Confirmation</span>
                    }
                    else
                    {
                        <span style="background:#fce4ec; color:#b71c1c; padding:8px 20px; border-radius:20px; font-size:14px; font-weight:700;">✕ @Model.Status</span>
                    }
                </div>
                <div style="text-align:right; font-size:13px; color:#888;">
                    Booked on<br />
                    <strong style="color:#1a1a1a; font-size:15px;">@Model.Timestamp.ToString("dd MMM yyyy")</strong>
                </div>
            </div>

            <!-- TRAVELLER LIST -->
            <div class="trip-card-detail">
                <h3 class="highlight">Travellers (@Model.Travellers.Count)</h3>
                <div style="display:flex; flex-direction:column; gap:10px; margin-top:12px;">
                    @{int tIdx = 1;}
                    @foreach (var t in Model.Travellers)
                    {
                        <div style="display:flex; align-items:center; gap:14px; background:#f9faf9; padding:12px 16px; border-radius:12px;">
                            <div style="width:38px; height:38px; border-radius:50%; background:linear-gradient(135deg,#2a8153,#1a4f36); display:flex; align-items:center; justify-content:center; color:white; font-weight:700; font-size:14px;">
                                @(t.Name.Length > 0 ? t.Name[0].ToString().ToUpper() : "T")
                            </div>
                            <div style="flex:1;">
                                <div style="font-weight:600; font-size:14px;">@t.Name</div>
                                <div style="font-size:12px; color:#888;">Age: @t.Age</div>
                            </div>
                            <span style="background:@(t.TravellerType=="Child" ? "#fff8e1" : "#e8f5e9"); color:@(t.TravellerType=="Child" ? "#e65100" : "#1b5e20"); padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700;">
                                @t.TravellerType
                            </span>
                        </div>
                        tIdx++;
                    }
                </div>
            </div>

            <!-- ITINERARY -->
            @if (!string.IsNullOrEmpty(Model.Package?.Itinerary))
            {
                <div class="trip-card-detail">
                    <h3 class="highlight">Itinerary</h3>
                    <div style="margin-top:12px;">
                        @{int day = 0;}
                        @foreach (var line in Model.Package.Itinerary.Split('\n').Where(l => !string.IsNullOrWhiteSpace(l)))
                        {
                            day++;
                            <div class="itinerary-day" style="display:flex; gap:14px; align-items:flex-start; margin-bottom:12px;">
                                <div class="day-dot">@day</div>
                                <p style="margin:0; font-size:14px; color:#444; line-height:1.6;">@line.Trim()</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- SPECIAL REQUESTS -->
            @if (!string.IsNullOrEmpty(Model.SpecialRequests))
            {
                <div class="trip-card-detail">
                    <h3 class="highlight">Special Requests</h3>
                    <p style="margin-top:10px; font-size:14px; color:#555; line-height:1.7;">@Model.SpecialRequests</p>
                </div>
            }

            <!-- REVIEWS SECTION -->
            <div class="trip-card-detail">
                <h3 class="highlight">Reviews for this Package</h3>

                @if (TempData["ReviewSuccess"] != null) { <div class="review-alert success">✓ @TempData["ReviewSuccess"]</div> }
                @if (TempData["ReviewError"]   != null) { <div class="review-alert error">⚠ @TempData["ReviewError"]</div> }

                @if (canReview)
                {
                    <div class="review-form-box" style="margin-top:16px;">
                        <h4 style="margin:0 0 12px; font-size:15px; color:#1a4f36;">Share Your Experience</h4>
                        <form asp-controller="Review" asp-action="Submit" method="post">
                            <input type="hidden" name="packageId" value="@Model.PackageId" />
                            <div class="star-select" id="starSelect">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <span class="star-opt" data-val="@s" onclick="selectStar(@s)">☆</span>
                                }
                                <input type="hidden" name="rating" id="ratingInput" value="5" />
                            </div>
                            <textarea name="comment" rows="3" placeholder="Describe your experience…"
                                      style="width:100%;padding:12px;border-radius:10px;border:1.5px solid #e0e0e0;font-family:inherit;font-size:13px;resize:none;margin-top:10px;box-sizing:border-box;"
                                      required></textarea>
                            <button type="submit" style="margin-top:10px; background:linear-gradient(135deg,#2a8153,#1a4f36); color:white; border:none; padding:10px 28px; border-radius:10px; font-size:14px; font-weight:600; cursor:pointer;">
                                Submit Review
                            </button>
                        </form>
                    </div>
                }

                @{
                    var reviews = Model.Package?.Reviews?.OrderByDescending(r => r.CreatedAt).ToList() ?? new();
                }
                @if (!reviews.Any())
                {
                    <p style="color:#aaa; font-size:14px; margin-top:12px;">No reviews yet for this package.</p>
                }
                else
                {
                    @foreach (var rv in reviews)
                    {
                        var initials = string.Join("", rv.User.Name.Split(' ').Take(2).Select(w => w[0]));
                        <div class="review-card" style="margin-top:14px;">
                            <div class="review-header">
                                <div class="review-avatar">@initials</div>
                                <div>
                                    <div class="review-author">@rv.User.Name</div>
                                    <div class="review-date">@rv.CreatedAt.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="review-stars" style="margin-left:auto;">
                                    @string.Concat(Enumerable.Range(1,5).Select(i => i <= rv.Rating ? "★" : "☆"))
                                </div>
                            </div>
                            <p class="review-comment">@rv.Comment</p>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ── RIGHT SIDEBAR ───────────────────────────────────── -->
        <div style="flex:1; display:flex; flex-direction:column; gap:16px;">
            <div class="trip-card-detail" style="padding:24px;">
                <h3 class="highlight" style="margin-bottom:16px;">Payment Summary</h3>
                <div style="line-height:2.2; font-size:14px;">
                    <div style="display:flex; justify-content:space-between;">
                        <span>Price/Person</span><span>₹@Model.Package?.Price.ToString("N0")</span>
                    </div>
                    <div style="display:flex; justify-content:space-between;">
                        <span>Travellers</span><span>@Model.Travellers.Count</span>
                    </div>
                    <hr style="margin:8px 0; border:none; border-top:1px solid #eee;" />
                    <div style="display:flex; justify-content:space-between; font-weight:700; font-size:18px; color:#1a4f36;">
                        <span>Total</span><span>₹@Model.TotalAmount.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <button onclick="location.href='@Url.Action("MyJourneys","Booking")'"
                    style="background:white; border:1.5px solid #ddd; color:#555; padding:12px; border-radius:12px; font-size:14px; font-weight:600; cursor:pointer; transition:0.2s;">
                ← Back to My Journeys
            </button>
        </div>

    </div>
}

@section Scripts {
<script>
    function selectStar(val) {
        document.getElementById('ratingInput').value = val;
        document.querySelectorAll('.star-opt').forEach((el, i) => {
            el.textContent = i < val ? '★' : '☆';
            el.style.color  = i < val ? '#f39c12' : '#ccc';
        });
    }
    document.addEventListener('DOMContentLoaded', () => { if(document.getElementById('ratingInput')) selectStar(5); });
</script>
}
