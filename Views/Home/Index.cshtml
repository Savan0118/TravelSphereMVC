@using System.Security.Claims
@inject TravelSphereMVC.Models.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Home";
    var userId     = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var profileImg = DbContext.Users.Find(userId)?.ProfileImageUrl
                     ?? "https://ui-avatars.com/api/?name=T&background=2a8153&color=fff&size=60";
    var trending  = ViewBag.TrendingPackages as List<TravelSphereMVC.Models.Package> ?? new();
    var featured  = ViewBag.FeaturedPackage  as TravelSphereMVC.Models.Package;

    // Wishlist IDs for heart icon
    var wishlistIds = string.IsNullOrEmpty(userId)
        ? new HashSet<string>()
        : DbContext.WishlistItems.Where(w => w.UserId == userId).Select(w => w.PackageId).ToHashSet();
}

@section Styles {
    <style>
        /* ── Trending Cards ─────────────────────────────── */
        .cards { display: flex; gap: 20px; margin-bottom: 36px; }

        .card {
            background: white;
            border-radius: 20px;
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .card:hover { transform: translateY(-8px); box-shadow: 0 16px 40px rgba(0,0,0,0.15); }

        .card-img-container {
            height: 160px;
            overflow: hidden;
            position: relative;
        }
        .card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
        .card:hover img { transform: scale(1.08); }

        .card-img-overlay {
            position: absolute; inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 60%);
        }

        .card-type-badge {
            position: absolute; top: 12px; left: 12px;
            background: rgba(42,129,83,0.9);
            color: white; padding: 3px 10px; border-radius: 20px;
            font-size: 11px; font-weight: 700; letter-spacing: 0.5px;
        }

        .card-heart {
            position: absolute; top: 10px; right: 12px;
            background: rgba(255,255,255,0.9);
            border: none; border-radius: 50%;
            width: 34px; height: 34px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 17px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            transition: transform 0.2s;
        }
        .card-heart:hover { transform: scale(1.15); }

        .card-info { padding: 16px; display: flex; flex-direction: column; flex: 1; }
        .card-info h3 { margin: 0 0 4px; font-size: 16px; font-weight: 700; color: #1a1a1a; }
        .card-location { margin: 0 0 6px; font-size: 12px; color: #2a8153; font-weight: 600; }
        .card-desc { margin: 0 0 14px; font-size: 12px; color: #777; line-height: 1.5; flex: 1; }

        .card-footer { display: flex; justify-content: space-between; align-items: center; }
        .card-price { font-size: 15px; font-weight: 700; color: #1a4f36; }
        .card-btn {
            background: linear-gradient(135deg, #2a8153, #1a4f36);
            color: white; border: none; border-radius: 20px;
            padding: 7px 18px; font-size: 12px; font-weight: 600;
            cursor: pointer; transition: opacity 0.2s;
        }
        .card-btn:hover { opacity: 0.88; }

        /* ── Featured Package ───────────────────────────── */
        .featured-card {
            display: flex; border-radius: 20px; overflow: hidden;
            background: white; box-shadow: 0 8px 30px rgba(0,0,0,0.10);
            transition: transform 0.3s, box-shadow 0.3s;
            margin-bottom: 30px; min-height: 220px;
        }
        .featured-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.16); }
        .featured-img { width: 340px; flex-shrink: 0; overflow: hidden; position: relative; }
        .featured-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
        .featured-card:hover .featured-img img { transform: scale(1.05); }

        .featured-body {
            background: linear-gradient(135deg, #1a4f36, #2a8153);
            color: white; padding: 30px; flex: 1;
            display: flex; flex-direction: column; justify-content: space-between;
        }
        .featured-body h3 { margin: 0 0 6px; font-size: 22px; font-weight: 700; }
        .featured-location { font-size: 13px; opacity: 0.85; margin-bottom: 10px; }
        .featured-desc { font-size: 13px; opacity: 0.9; line-height: 1.6; margin-bottom: 16px; flex: 1; }

        .featured-footer { display: flex; justify-content: space-between; align-items: center; }
        .featured-price-box {
            background: rgba(255,255,255,0.15);
            padding: 8px 16px; border-radius: 20px;
            display: flex; gap: 12px; align-items: center;
        }
        .featured-price-box span:first-child { font-size: 12px; opacity: 0.8; }
        .featured-price-box strong { font-size: 18px; }
        .featured-btn {
            background: white; color: #1a4f36; border: none;
            border-radius: 20px; padding: 10px 24px;
            font-size: 13px; font-weight: 700; cursor: pointer; transition: 0.2s;
        }
        .featured-btn:hover { background: #e8f5e9; }

        /* ── Section Headers ────────────────────────────── */
        .section-header-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
        .section-header-row h2 { font-size: 20px; font-weight: 700; margin: 0; color: #1a1a1a; }
        .view-all-link {
            font-size: 13px; font-weight: 600; color: #2a8153;
            cursor: pointer; text-decoration: none;
            display: flex; align-items: center; gap: 4px;
        }
        .view-all-link:hover { text-decoration: underline; }

        /* ── Empty State ────────────────────────────────── */
        .empty-state { text-align: center; padding: 50px; color: #aaa; }
        .empty-state i { font-size: 48px; color: #ddd; margin-bottom: 12px; display: block; }
    </style>
}

<!-- BANNER -->
<div class="banner">
    <div class="banner-text">
        <h1>Explore the World Without Limits</h1>
        <p>Find destinations, build your perfect trip, and create lifelong memories</p>
    </div>
    <img src="@profileImg" class="profile"
         onclick="location.href='@Url.Action("Profile", "Account")'"
         style="cursor:pointer; border-radius:50%; width:50px; height:50px; object-fit:cover; border:2px solid white;" />
</div>

<div class="content-area">

    <!-- ── TRENDING DESTINATIONS ──────────────────────────────────── -->
    <div class="section-header-row">
        <h2>🔥 Trending Destinations</h2>
        <a class="view-all-link" href="@Url.Action("Packages", "Home")">
            View All <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

    @if (trending.Any())
    {
        <div class="cards">
            @foreach (var pkg in trending)
            {
                var inWl = wishlistIds.Contains(pkg.Id);
                <div class="card">
                    <div class="card-img-container">
                        <img src="@(pkg.ImageUrl ?? "/Images/placeholder.png")"
                             alt="@pkg.Name"
                             onerror="this.src='https://placehold.co/400x220/2a8153/white?text=Travel'" />
                        <div class="card-img-overlay"></div>
                        @if (!string.IsNullOrEmpty(pkg.DestinationType))
                        {
                            <span class="card-type-badge">@pkg.DestinationType</span>
                        }
                        <form asp-controller="Wishlist" asp-action="@(inWl ? "Remove" : "Add")" method="post" style="position:absolute; top:10px; right:12px; margin:0;">
                            <input type="hidden" name="packageId" value="@pkg.Id" />
                            <input type="hidden" name="returnUrl"  value="/" />
                            <button type="submit" class="card-heart" title="@(inWl ? "Remove from Wishlist" : "Save")">
                                @(inWl ? "❤️" : "🤍")
                            </button>
                        </form>
                    </div>
                    <div class="card-info">
                        <h3>@pkg.Name</h3>
                        <p class="card-location"><i class="fa-solid fa-location-dot"></i> @pkg.Location</p>
                        <p class="card-desc">@(pkg.ShortDescription ?? pkg.ActivitiesList ?? pkg.Duration)</p>
                        <div class="card-footer">
                            <span class="card-price">₹@pkg.Price.ToString("N0")</span>
                            <button class="card-btn" onclick="location.href='@Url.Action("Description", "Home", new { id = pkg.Id })'">View</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-map-location-dot"></i>
            <p>No packages available yet. Check back soon!</p>
        </div>
    }

    <!-- ── FEATURED PACKAGE ───────────────────────────────────────── -->
    <div class="section-header-row" style="margin-top: 10px;">
        <h2>⭐ Featured Package</h2>
    </div>

    @if (featured != null)
    {
        <div class="featured-card">
            <div class="featured-img">
                <img src="@(featured.ImageUrl ?? "/Images/placeholder.png")"
                     alt="@featured.Name"
                     onerror="this.src='https://placehold.co/600x300/1a4f36/white?text=Featured'" />
            </div>
            <div class="featured-body">
                <div>
                    <h3>@featured.Name</h3>
                    <p class="featured-location">
                        <i class="fa-solid fa-location-dot"></i>
                        @featured.Location@(featured.Country != null ? $", {featured.Country}" : "")
                    </p>
                    <p class="featured-desc">
                        @(featured.ShortDescription ?? featured.ActivitiesList ?? "An unforgettable travel experience awaits you.")
                    </p>
                </div>
                <div class="featured-footer">
                    <div class="featured-price-box">
                        <span>@featured.Duration</span>
                        <strong>₹@featured.Price.ToString("N0")</strong>
                    </div>
                    <button class="featured-btn"
                            onclick="location.href='@Url.Action("Description", "Home", new { id = featured.Id })'">
                        View Details
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-star"></i>
            <p>No featured packages at the moment.</p>
        </div>
    }

</div>
