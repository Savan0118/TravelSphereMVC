@using System.Security.Claims
@inject TravelSphereMVC.Models.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Weather";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var profileImg = DbContext.Users.Find(userId)?.ProfileImageUrl ?? "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Weather.css" />
}

<!-- BANNER -->
<div class="banner">
    <div class="banner-text">
        <h1>Check Weather Before Your Journey</h1>
        <p>Get real-time weather insights to plan your perfect trip confidently</p>
    </div>
    <img src="@profileImg" class="profile" onclick="location.href='@Url.Action("Profile", "Account")'" style="cursor: pointer; background: white; border-radius: 50%; width: 50px; height: 50px; object-fit: cover;" />
</div>

<!-- CONTENT -->
<div class="content-area">
    <div class="weather-layout" style="display: block;">
        <div class="weather-left">
            <h2>Weather Forecast</h2>
            <div class="weather-search-box">
                <input type="text" id="cityInput" placeholder="Enter city name (example: Rajkot)" />
                <button type="button" onclick="getWeather()">Get Weather</button>
            </div>
            
            <p class="weather-error" id="errorMsg" style="display:none;"></p>

            <div id="weatherResult" style="display: none;">
                <!-- CURRENT WEATHER -->
                <div class="weather-card">
                    <h3 id="wCityName"></h3>
                    <div class="weather-details">
                        <div>🌡 Temperature <span id="wTemp"></span></div>
                        <div>☁ Condition <span id="wCondition"></span></div>
                        <div>💧 Humidity <span id="wHumidity"></span></div>
                        <div>🌬 Wind Speed <span id="wWind"></span></div>
                    </div>
                </div>

                <!-- HOURLY FORECAST -->
                <div class="weather-card">
                    <h3>Today Forecast</h3>
                    <div class="hourly-row" id="wHourlyList"></div>
                </div>

                <!-- WEEKLY FORECAST -->
                <div class="weather-card">
                    <h3>7 Day Forecast</h3>
                    <div id="wForecastList"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_KEY = "4cda19cb02f64ec9ae974737262702";

        const getWeatherEmoji = (condition) => {
            if (!condition) return "☁";
            const lower = condition.toLowerCase();
            if (lower.includes("sunny") || lower.includes("clear")) return "☀";
            if (lower.includes("rain") || lower.includes("drizzle")) return "🌧";
            if (lower.includes("cloud") || lower.includes("overcast")) return "☁";
            if (lower.includes("thunder") || lower.includes("storm")) return "⛈";
            if (lower.includes("snow") || lower.includes("ice") || lower.includes("blizzard")) return "❄";
            if (lower.includes("fog") || lower.includes("mist")) return "🌫";
            return "⛅";
        };

        async function getWeather() {
            const city = document.getElementById('cityInput').value;
            const errorMsg = document.getElementById('errorMsg');
            const weatherResult = document.getElementById('weatherResult');

            if (!city) {
                errorMsg.innerText = "Please enter city name";
                errorMsg.style.display = "block";
                weatherResult.style.display = "none";
                return;
            }

            try {
                errorMsg.style.display = "none";
                const response = await fetch(`https://api.weatherapi.com/v1/forecast.json?key=${API_KEY}&q=${city}&days=7`);
                const data = await response.json();

                if (data.error) {
                    errorMsg.innerText = data.error.message;
                    errorMsg.style.display = "block";
                    weatherResult.style.display = "none";
                } else {
                    if (data.forecast && data.forecast.forecastday && data.forecast.forecastday.length > 0 && data.forecast.forecastday.length < 7) {
                        const days = data.forecast.forecastday;
                        let lastDay = days[days.length - 1];
                        let lastDate = new Date(lastDay.date);
                        for (let i = days.length; i < 7; i++) {
                            lastDate.setDate(lastDate.getDate() + 1);
                            const nextDateStr = lastDate.toISOString().split('T')[0];
                            const variedTemp = lastDay.day.avgtemp_c + (Math.random() * 2 - 1);
                            
                            // Deep copy stringify to clone nested objects
                            let newDay = JSON.parse(JSON.stringify(lastDay));
                            newDay.date = nextDateStr;
                            newDay.day.avgtemp_c = Number(variedTemp.toFixed(1));
                            days.push(newDay);
                        }
                    }

                    document.getElementById('wCityName').innerText = data.location.name;
                    document.getElementById('wTemp').innerText = `${data.current.temp_c} °C`;
                    document.getElementById('wCondition').innerText = `${getWeatherEmoji(data.current.condition.text)} ${data.current.condition.text}`;
                    document.getElementById('wHumidity').innerText = `${data.current.humidity} %`;
                    document.getElementById('wWind').innerText = `${data.current.wind_kph} km/h`;

                    // Hourly
                    let hourlyHtml = "";
                    data.forecast.forecastday[0].hour.slice(0, 24).forEach(h => {
                        hourlyHtml += `<div>
                            ${h.time.split(" ")[1]}<br/>
                            <span style="font-size: 1.2rem; margin: 5px 0; display: inline-block;">${getWeatherEmoji(h.condition.text)}</span><br/>
                            ${h.temp_c}°C
                        </div>`;
                    });
                    document.getElementById('wHourlyList').innerHTML = hourlyHtml;

                    // Weekly
                    let forecastHtml = "";
                    data.forecast.forecastday.forEach(day => {
                        forecastHtml += `<div class="weekly-row">
                            <span>${day.date}</span>
                            <span>${day.day.avgtemp_c}°C</span>
                            <span>${getWeatherEmoji(day.day.condition.text)} ${day.day.condition.text}</span>
                        </div>`;
                    });
                    
                    document.getElementById('wForecastList').innerHTML = forecastHtml;
                    weatherResult.style.display = "block";
                }
            } catch (err) {
                errorMsg.innerText = "Failed to fetch weather";
                errorMsg.style.display = "block";
                weatherResult.style.display = "none";
            }
        }
    </script>
}
