@using System.Security.Claims
@inject TravelSphereMVC.Models.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Budget Planner Result";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var profileImg = DbContext.Users.Find(userId)?.ProfileImageUrl ?? "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png";
}

@section Styles {
    <link rel="stylesheet" href="~/css/BudgetResult.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
}

<div class="banner budget-banner">
    <div class="banner-overlay"></div>
    <div class="banner-text">
        <h1>Trip Budget Result</h1>
        <p>Smart breakdown of your travel expenses</p>
    </div>
    <img src="@profileImg" class="profile" onclick="location.href='@Url.Action("Profile", "Account")'" style="position: absolute; right: 30px; top: 30px; z-index: 10; cursor: pointer; background: white; border-radius: 50%; width: 50px; height: 50px; object-fit: cover;" />
</div>

<div class="content-area">
    <div class="result-container">
        <!-- TOP SECTION -->
        <div class="top-section" style="display: flex; gap: 20px;">
            <!-- CHART -->
            <div class="chart-card glass" style="flex: 1;">
                <h3>Budget Summary</h3>
                <div class="chart-wrapper" style="position: relative; height: 300px; padding: 20px; display: flex; align-items: center; justify-content: center;">
                    <canvas id="budgetChart"></canvas>
                    <div class="chart-center" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; font-size: 1.5rem; font-weight: bold;">
                        <span id="chartTotalValue"></span>
                        <br/><span style="font-size: 1rem; color: #555;">Total</span>
                    </div>
                </div>
            </div>

            <!-- SUMMARY -->
            <div class="summary-card glass" style="flex: 1;" id="summaryCardList">
                <!-- Dynamically populated -->
            </div>
        </div>

        <!-- EXPENSE LIST -->
        <div class="expense-section glass" style="margin-top: 20px;">
            <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3>Expense Breakdown</h3>
                <button class="add-btn" style="background: none; border: 1px solid #1a4f36; color: #1a4f36; padding: 8px 15px; border-radius: 20px; cursor: pointer; font-weight: bold;">+ Add Expense</button>
            </div>
            
            <div id="expenseListBlock">
                <!-- Dynamically populated -->
            </div>
        </div>
    </div>
    
    <!-- STICKY FOOTER -->
    <div class="bottom-bar" style="position: fixed; bottom: 0; left: 0; right: 0; background: white; box-shadow: 0 -4px 10px rgba(0,0,0,0.1); display: flex; justify-content: space-between; align-items: center; padding: 15px 30px; z-index: 100;">
        <div class="trip-info" id="stickyTripInfo">
            <!-- Dynamically populated -->
        </div>

        <div class="final-box" style="display: flex; gap: 20px; align-items: center; font-size: 1.5rem; font-weight: bold;">
            <span id="footerTotal"></span>
            <button class="confirm-btn" style="background-color: #1a4f36; color: white; padding: 10px 20px; border-radius: 8px; border: none; cursor: pointer; font-size: 1rem;">Confirm Budget</button>
        </div>
    </div>
</div>

<input type="hidden" id="TotalCalculatedServer" value="@ViewBag.TotalCalculated" />
<input type="hidden" id="FormStateServer" value="@ViewBag.FormState" />

@section Scripts {
    <script>
        let expenses = [
            { id: 1, title: "Accommodation", desc: "4 Rooms · ₹1500/night", amount: 40000, color: "#e74c3c" },
            { id: 2, title: "Transport", desc: "Bus Travel · 300 km", amount: 9600, color: "#2ecc71" },
            { id: 3, title: "Food & Activities", desc: "₹950/person · 4 travellers", amount: 17000, color: "#f1c40f" },
            { id: 4, title: "Additional", desc: "Shopping & misc", amount: 12200, color: "#6c5ce7" }
        ];

        // Replace dummy static data if the server passed the calculated form state!
        // We override expenses array proportionally to match the total calculated.
        const totalCalcStr = document.getElementById("TotalCalculatedServer").value;
        const formStateStr = document.getElementById("FormStateServer").value;
        let finalForm = null;

        if (totalCalcStr && formStateStr) {
            const rawTotal = parseInt(totalCalcStr) || 0;
            finalForm = JSON.parse(formStateStr.replaceAll('&quot;', '"'));
            
            // Generate custom expenses based on formState to mirror realistic splits:
            const accEst = finalForm.days * 1500 * (finalForm.rooms || 1);
            const foodEst = finalForm.days * finalForm.travelers * 800;
            
            expenses = [
                { id: 1, title: "Accommodation", desc: `${finalForm.rooms || 1} Rooms · Standard`, amount: accEst, color: "#e74c3c" },
                { id: 2, title: "Transport", desc: `${finalForm.travelMode || "Any"} Travel`, amount: 9600, color: "#2ecc71" },
                { id: 3, title: "Food & Activities", desc: `Meals for ${finalForm.travelers} travellers`, amount: foodEst, color: "#f1c40f" },
                { id: 4, title: "Additional", desc: "Miscellaneous", amount: Math.max(2000, rawTotal - accEst - foodEst - 9600), color: "#6c5ce7" }
            ];
        }

        let myChart = null;

        function removeExpense(id) {
            expenses = expenses.filter(e => e.id !== id);
            renderUI();
        }

        function renderUI() {
            const total = expenses.reduce((a, b) => a + b.amount, 0);
            const buffer = Math.round(total * 0.1);
            const finalTotal = total + buffer;

            // 1. Chart Data Update
            const ctx = document.getElementById('budgetChart');
            if(myChart) myChart.destroy();
            myChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: expenses.map(e => e.title),
                    datasets: [{
                        data: expenses.map(e => e.amount),
                        backgroundColor: expenses.map(e => e.color),
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

            document.getElementById('chartTotalValue').innerText = `₹ ${total}`;

            // 2. Summary Card Render
            let summaryHTML = `<h3>Budget Overview</h3>`;
            expenses.forEach(e => {
                summaryHTML += `<div class="summary-row" style="display: flex; justify-content: space-between; margin: 10px 0;">
                    <span>${e.title}</span><span style="font-weight:bold;">₹ ${e.amount}</span>
                </div>`;
            });
            summaryHTML += `<div class="summary-row buffer" style="display: flex; justify-content: space-between; margin: 10px 0; color: gray;">
                <span>Buffer (10%)</span><span>₹ ${buffer}</span>
            </div><hr style="margin: 15px 0; border: 0.5px solid #eaeaea;"/>`;
            summaryHTML += `<div class="summary-row total" style="display: flex; justify-content: space-between; font-weight: bold; font-size: 1.2rem;">
                <span>Total</span><span>₹ ${finalTotal}</span>
            </div>`;
            document.getElementById('summaryCardList').innerHTML = summaryHTML;

            // 3. Expense List Display
            let expenseListHTML = "";
            expenses.forEach(e => {
                expenseListHTML += `
                <div class="expense-card" style="display: flex; justify-content: space-between; align-items: center; background: white; padding: 15px; border-radius: 8px; margin-bottom: 10px; border: 1px solid #f0f0f0;">
                    <div class="expense-left" style="display: flex; align-items: center; gap: 15px;">
                        <div class="color-dot" style="background: ${e.color}; width: 12px; height: 12px; border-radius: 50%;"></div>
                        <div>
                            <h4 style="margin: 0; font-size: 1rem;">${e.title}</h4>
                            <p style="margin: 5px 0 0; color: #888; font-size: 0.85rem;">${e.desc}</p>
                        </div>
                    </div>
                    <div class="expense-right" style="display: flex; align-items: center; gap: 20px; font-weight: bold;">
                        ₹ ${e.amount}
                        <div class="actions" style="display: flex; gap: 10px;">
                            <button style="border: none; background: #e0f2fe; padding: 5px; border-radius: 5px; cursor: pointer;">✏️</button>
                            <button onclick="removeExpense(${e.id})" style="border: none; background: #fee2e2; padding: 5px; border-radius: 5px; cursor: pointer;">🗑️</button>
                        </div>
                    </div>
                </div>`;
            });
            document.getElementById('expenseListBlock').innerHTML = expenseListHTML;

            // 4. Sticky Footer Update
            if (finalForm) {
                document.getElementById('stickyTripInfo').innerHTML = `👥 ${finalForm.travelers || 4} Travellers &nbsp; | &nbsp; 📅 ${finalForm.days || 5} Days`;
            } else {
                document.getElementById('stickyTripInfo').innerHTML = `👥 4 Travellers &nbsp; | &nbsp; 📅 5 Days &nbsp; | &nbsp; 📍 16 Mar 2027`;
            }
            document.getElementById('footerTotal').innerText = `₹ ${finalTotal}`;
        }

        renderUI();
    </script>
}
