@model TravelSphereMVC.Models.Package
@using System.Security.Claims
@inject TravelSphereMVC.Models.ApplicationDbContext DbContext
@{
    ViewData["Title"] = Model.Name;
    var userId     = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
    var profileImg = DbContext.Users.Find(userId)?.ProfileImageUrl
                     ?? "https://ui-avatars.com/api/?name=T&background=2a8153&color=fff";
    bool canReview  = (bool)(ViewBag.CanReview  ?? false);
    double avgRating= (double)(ViewBag.AverageRating ?? 0.0);
    bool inWishlist = (bool)(ViewBag.InWishlist ?? false);
    var galleryUrls = string.IsNullOrEmpty(Model.GalleryImages)
        ? Array.Empty<string>()
        : Model.GalleryImages.Split(',').Select(u => u.Trim()).Where(u => !string.IsNullOrEmpty(u)).ToArray();
    var stars = string.Concat(Enumerable.Range(1,5).Select(i => i <= (int)Math.Round(avgRating) ? "★" : "☆"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/Description.css" />
}

<!-- HERO BANNER -->
<div class="description-banner banner"
     style="background-image:url('@(Model.ImageUrl ?? "/Images/placeholder.png")'); min-height:260px; max-height:260px;">
    <div class="banner-overlay"></div>
    <div class="banner-text" style="padding:40px;">
        <div class="banner-badges">
            @if (!string.IsNullOrEmpty(Model.DestinationType)) { <span>@Model.DestinationType</span> }
            @if (!string.IsNullOrEmpty(Model.TravelType))      { <span>@Model.TravelType</span> }
            @if (!string.IsNullOrEmpty(Model.DifficultyLevel)) { <span>@Model.DifficultyLevel</span> }
        </div>
        <h1 style="color:white; font-size:28px; margin:0 0 6px; text-shadow:0 2px 12px rgba(0,0,0,0.4);">@Model.Name</h1>
        <p style="color:rgba(255,255,255,0.9); font-size:14px; margin:0;">
            <i class="fa-solid fa-location-dot"></i>
            @Model.Location@(Model.State != null ? $", {Model.State}" : "")@(Model.Country != null ? $", {Model.Country}" : "")
        </p>
        @if (avgRating > 0)
        {
            <div style="margin-top:10px;">
                <span style="color:#ffd700; font-size:18px; letter-spacing:2px;">@stars</span>
                <span style="color:white; font-size:13px; margin-left:8px;">@avgRating.ToString("F1") (@Model.Reviews.Count review@(Model.Reviews.Count!=1?"s":""))</span>
            </div>
        }
    </div>
    <img src="@profileImg" class="profile"
         onclick="location.href='@Url.Action("Profile","Account")'"
         style="cursor:pointer;border-radius:50%;width:50px;height:50px;object-fit:cover;border:2px solid white;position:absolute;top:24px;right:28px;z-index:3;" />
</div>

<div class="content-area description-layout">

    <!-- ── LEFT ─────────────────────────────────────────────────────── -->
    <div class="description-left">

        <!-- ABOUT -->
        @if (!string.IsNullOrEmpty(Model.FullDescription) || !string.IsNullOrEmpty(Model.ShortDescription))
        {
            <div class="description-box glass">
                <h3 class="highlight">About This Package</h3>
                <p class="text">@(Model.FullDescription ?? Model.ShortDescription)</p>
            </div>
        }

        <!-- TRAVEL DETAILS -->
        <div class="description-box glass" style="margin-top:20px;">
            <h3 class="highlight">Travel Details</h3>
            <div class="detail-grid">
                <div class="detail-item"><i class="fa-solid fa-location-dot"></i><span><strong>Location</strong><br/>@Model.Location</span></div>
                <div class="detail-item"><i class="fa-regular fa-clock"></i><span><strong>Duration</strong><br/>@Model.Duration</span></div>
                @if (!string.IsNullOrEmpty(Model.BestSeason))
                { <div class="detail-item"><i class="fa-solid fa-sun"></i><span><strong>Best Season</strong><br/>@Model.BestSeason</span></div> }
                @if (!string.IsNullOrEmpty(Model.PickupPoint))
                { <div class="detail-item"><i class="fa-solid fa-bus"></i><span><strong>Pickup</strong><br/>@Model.PickupPoint</span></div> }
                @if (!string.IsNullOrEmpty(Model.DropPoint))
                { <div class="detail-item"><i class="fa-solid fa-flag-checkered"></i><span><strong>Drop</strong><br/>@Model.DropPoint</span></div> }
                @if (!string.IsNullOrEmpty(Model.TravelType))
                { <div class="detail-item"><i class="fa-solid fa-users"></i><span><strong>Travel Type</strong><br/>@Model.TravelType</span></div> }
            </div>
        </div>

        <!-- HOTEL & FOOD -->
        @if (!string.IsNullOrEmpty(Model.HotelName) || Model.HotelRating != null)
        {
            <div class="description-box glass" style="margin-top:20px;">
                <h3 class="highlight">Hotel &amp; Food</h3>
                <div class="detail-grid">
                    @if (!string.IsNullOrEmpty(Model.HotelName))
                    { <div class="detail-item"><i class="fa-solid fa-hotel"></i><span><strong>Hotel</strong><br/>@Model.HotelName</span></div> }
                    @if (Model.HotelRating != null)
                    { <div class="detail-item"><i class="fa-solid fa-star"></i><span><strong>Rating</strong><br/>@string.Concat(Enumerable.Repeat("⭐", Model.HotelRating.Value))</span></div> }
                    @if (!string.IsNullOrEmpty(Model.RoomType))
                    { <div class="detail-item"><i class="fa-solid fa-bed"></i><span><strong>Room</strong><br/>@Model.RoomType</span></div> }
                    @if (!string.IsNullOrEmpty(Model.MealsIncluded))
                    { <div class="detail-item"><i class="fa-solid fa-utensils"></i><span><strong>Meals</strong><br/>@Model.MealsIncluded</span></div> }
                </div>
            </div>
        }

        <!-- ACTIVITIES -->
        @if (!string.IsNullOrEmpty(Model.ActivitiesList))
        {
            <div class="description-box glass" style="margin-top:20px;">
                <h3 class="highlight">Activities Included</h3>
                <div class="activity-tags">
                    @foreach (var act in Model.ActivitiesList.Split(',').Select(a => a.Trim()).Where(a => !string.IsNullOrEmpty(a)))
                    {
                        <span class="activity-tag">✓ @act</span>
                    }
                </div>
            </div>
        }

        <!-- SPECIAL ATTRACTIONS -->
        @if (!string.IsNullOrEmpty(Model.SpecialAttractions))
        {
            <div class="description-box glass" style="margin-top:20px;">
                <h3 class="highlight">Special Attractions</h3>
                <p class="text">@Model.SpecialAttractions</p>
            </div>
        }

        <!-- ITINERARY -->
        @if (!string.IsNullOrEmpty(Model.Itinerary))
        {
            <div class="description-box glass" style="margin-top:20px;">
                <h3 class="highlight">Day-Wise Itinerary</h3>
                <div class="itinerary-timeline">
                    @{
                        int dayNum = 0;
                        foreach (var line in Model.Itinerary.Split('\n').Where(l => !string.IsNullOrWhiteSpace(l)))
                        {
                            dayNum++;
                            <div class="itinerary-day">
                                <div class="day-dot">@dayNum</div>
                                <p>@line.Trim()</p>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        <!-- GALLERY -->
        @if (galleryUrls.Any())
        {
            <div class="description-box glass" style="margin-top:20px;">
                <h3 class="highlight">Gallery</h3>
                <div class="gallery-grid">
                    @foreach (var url in galleryUrls)
                    {
                        <div class="gallery-item">
                            <img src="@url" onerror="this.style.display='none'" alt="Gallery" />
                        </div>
                    }
                </div>
            </div>
        }

        <!-- REVIEWS -->
        <div class="description-box glass" style="margin-top:20px;">
            <h3 class="highlight">Traveller Reviews</h3>

            @if (TempData["ReviewSuccess"] != null)
            {
                <div class="review-alert success">✓ @TempData["ReviewSuccess"]</div>
            }
            @if (TempData["ReviewError"] != null)
            {
                <div class="review-alert error">⚠ @TempData["ReviewError"]</div>
            }

            @if (canReview)
            {
                <div class="review-form-box">
                    <h4 style="margin:0 0 12px; font-size:15px;">Leave a Review</h4>
                    <form asp-controller="Review" asp-action="Submit" method="post">
                        <input type="hidden" name="packageId" value="@Model.Id" />
                        <div class="star-select" id="starSelect">
                            @for (int s = 1; s <= 5; s++)
                            {
                                <span class="star-opt" data-val="@s" onclick="selectStar(@s)">☆</span>
                            }
                            <input type="hidden" name="rating" id="ratingInput" value="5" />
                        </div>
                        <textarea name="comment" rows="3" placeholder="Share your experience…"
                                  style="width:100%;padding:12px;border-radius:10px;border:1.5px solid #e0e0e0;font-family:inherit;font-size:13px;resize:none;margin-top:10px;box-sizing:border-box;"
                                  required></textarea>
                        <button type="submit" class="book-btn" style="margin-top:10px; padding:10px 28px; font-size:14px;">
                            Submit Review
                        </button>
                    </form>
                </div>
            }

            @if (!Model.Reviews.Any())
            {
                <p style="color:#aaa; font-size:14px; margin-top:10px;">No reviews yet. Be the first to review!</p>
            }
            else
            {
                @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                {
                    var initials = string.Join("", review.User.Name.Split(' ').Take(2).Select(w => w[0]));
                    <div class="review-card">
                        <div class="review-header">
                            <div class="review-avatar">@initials</div>
                            <div>
                                <div class="review-author">@review.User.Name</div>
                                <div class="review-date">@review.CreatedAt.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="review-stars">
                                @string.Concat(Enumerable.Range(1,5).Select(i => i <= review.Rating ? "★" : "☆"))
                            </div>
                        </div>
                        <p class="review-comment">@review.Comment</p>
                    </div>
                }
            }
        </div>

    </div>

    <!-- ── RIGHT SIDEBAR ─────────────────────────────────────────── -->
    <div class="description-right">

        <!-- PRICE CARD -->
        <div class="info-card glass">
            @if (Model.DiscountPercentage > 0)
            {
                var discounted = Model.Price - (Model.Price * (Model.DiscountPercentage ?? 0) / 100);
                <div style="text-align:center; margin-bottom:8px;">
                    <span style="text-decoration:line-through; color:#aaa; font-size:16px;">₹@Model.Price.ToString("N0")</span>
                    <span style="background:#e74c3c; color:white; padding:2px 8px; border-radius:8px; font-size:11px; margin-left:8px; font-weight:700;">@Model.DiscountPercentage% OFF</span>
                </div>
                <div style="font-size:28px; font-weight:800; color:#1a4f36; text-align:center; margin-bottom:4px;">₹@discounted.ToString("N0")</div>
            }
            else
            {
                <div style="font-size:28px; font-weight:800; color:#1a4f36; text-align:center; margin-bottom:4px;">₹@Model.Price.ToString("N0")</div>
            }
            <p style="text-align:center; color:#888; font-size:12px; margin:0 0 16px;">per person</p>

            <div style="border-top:1px solid #f0f0f0; padding-top:14px; line-height:2.1; font-size:14px;">
                <p><strong>Package :</strong> @Model.Name</p>
                <p><strong>Duration :</strong> @Model.Duration</p>
                <p><strong>Location :</strong> @Model.Location</p>
                @if (Model.TotalSeats > 0)
                {
                    <p><strong>Seats :</strong>
                        <span style="color:#2a8153; font-weight:700;">@Model.TotalSeats available</span>
                    </p>
                }
            </div>
        </div>

        <!-- WISHLIST TOGGLE -->
        <form asp-controller="Wishlist" asp-action="@(inWishlist?"Remove":"Add")" method="post" style="margin:0;">
            <input type="hidden" name="packageId" value="@Model.Id" />
            <input type="hidden" name="returnUrl"  value="@Url.Action("Description","Home",new{id=Model.Id})" />
            <button type="submit" class="book-btn"
                    style="background:@(inWishlist ? "#e74c3c" : "rgba(42,129,83,0.12)"); color:@(inWishlist ? "white" : "#2a8153"); border:1.5px solid @(inWishlist ? "#e74c3c" : "#2a8153"); width:100%;">
                @(inWishlist ? "❤️ Remove from Wishlist" : "🤍 Save to Wishlist")
            </button>
        </form>

        <!-- BOOK NOW -->
        <button class="book-btn"
                onclick="location.href='@Url.Action("Create","Booking",new{packageId=Model.Id})'">
            ✈️ Book Now
        </button>

        <!-- ITINERARY CARD -->
        @if (!string.IsNullOrEmpty(Model.Itinerary))
        {
            <div class="itinerary-card glass">
                <h3 class="highlight center">Quick Itinerary</h3>
                <ul class="inclusion-list">
                    @foreach (var line in Model.Itinerary.Split('\n').Take(5).Where(l => !string.IsNullOrWhiteSpace(l)))
                    {
                        <li>📍 @line.Trim()</li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function selectStar(val) {
        document.getElementById('ratingInput').value = val;
        document.querySelectorAll('.star-opt').forEach((el, i) => {
            el.textContent = i < val ? '★' : '☆';
            el.style.color  = i < val ? '#f39c12' : '#ccc';
        });
    }
    // Init stars to 5
    document.addEventListener('DOMContentLoaded', () => selectStar(5));
</script>
}
