@using System.Security.Claims
@inject TravelSphereMVC.Models.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Budget Planner";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var profileImg = DbContext.Users.Find(userId)?.ProfileImageUrl ?? "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png";
}

@section Styles {
    <link rel="stylesheet" href="~/css/BudgetPlanner.css" />
}

<div class="banner">
    <div class="banner-text">
        <h1>Plan Your Trip Budget</h1>
        <p>Get a realistic travel cost estimate based on your preferences</p>
    </div>
    <img src="@profileImg" class="profile" onclick="location.href='@Url.Action("Profile", "Account")'" style="cursor: pointer; background: white; border-radius: 50%; width: 50px; height: 50px; object-fit: cover;" />
</div>

<div class="content-area">
    <div class="budget-card">
        <form id="budgetForm" action="@Url.Action("BudgetResult", "Home")" method="get">
            <div class="grid-2">
                <div>
                    <label>Number of Days</label>
                    <input type="number" id="days" name="days" />
                </div>
                <div>
                    <label>Number of Travelers</label>
                    <input type="number" id="travelers" name="travelers" />
                </div>
                <div>
                    <label>Destination Type</label>
                    <select id="destinationType" name="destinationType">
                        <option value="">Select</option>
                        <option>Mountains</option>
                        <option>Beach</option>
                        <option>City</option>
                        <option>Spiritual</option>
                    </select>
                </div>
                <div>
                    <label>Travel Style</label>
                    <select id="travelStyle" name="travelStyle">
                        <option value="">Select</option>
                        <option value="budget">Budget</option>
                        <option value="standard">Standard</option>
                        <option value="luxury">Luxury</option>
                    </select>
                </div>
                <div>
                    <label>Travel Mode</label>
                    <select id="travelMode" name="travelMode">
                        <option value="">Select</option>
                        <option value="bus">Bus</option>
                        <option value="train">Train</option>
                        <option value="flight">Flight</option>
                    </select>
                </div>
                <div>
                    <label>Hotel Type</label>
                    <select id="hotel" name="hotel">
                        <option value="">Select</option>
                        <option value="standard">Standard</option>
                        <option value="premium">Premium</option>
                        <option value="luxury">Luxury</option>
                    </select>
                </div>
                <div>
                    <label>Rooms Required</label>
                    <input type="number" id="rooms" name="rooms" />
                </div>
                <div>
                    <label>Meals Included</label>
                    <select id="meals" name="meals">
                        <option value="">Select</option>
                        <option value="yes">Yes</option>
                        <option value="no">No</option>
                    </select>
                </div>
                <div>
                    <label>Food Preference</label>
                    <select id="foodPreference" name="foodPreference">
                        <option value="">Select</option>
                        <option>Veg</option>
                        <option>Non-Veg</option>
                        <option>Mixed</option>
                    </select>
                </div>
                <div>
                    <label>Activities</label>
                    <select id="activities" name="activities">
                        <option value="">Select</option>
                        <option value="basic">Basic</option>
                        <option value="adventure">Adventure</option>
                        <option value="premium">Premium</option>
                    </select>
                </div>
                <div>
                    <label>Local Transport</label>
                    <select id="localTransport" name="localTransport">
                        <option value="">Select</option>
                        <option value="cab">Cab</option>
                        <option value="bike">Bike</option>
                        <option value="public">Public Transport</option>
                    </select>
                </div>
                <div>
                    <label>Guide Required</label>
                    <select id="guide" name="guide">
                        <option value="">Select</option>
                        <option value="yes">Yes</option>
                        <option value="no">No</option>
                    </select>
                </div>
                <div>
                    <label>Distance (km)</label>
                    <input type="number" id="maxDist" name="maxDist" />
                </div>
                <div>
                    <label>Extra Buffer (%)</label>
                    <input type="number" id="buffer" name="buffer" placeholder="Recommended 10-15%" />
                </div>
            </div>

            <!-- React BudgetResult.jsx mimics the navigation states, so we'll pass state context via JSON to the next page -->
            <input type="hidden" name="totalCalculated" id="totalCalculated" value="0" />
            <input type="hidden" name="formState" id="formState" value="" />

            <button type="button" class="generate-btn" onclick="calculateAndSubmit()">
                Generate Budget
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function calculateAndSubmit() {
            const days = Math.max(0, Number(document.getElementById("days").value));
            const travelers = Math.max(0, Number(document.getElementById("travelers").value));
            if (!days || !travelers) {
                alert("Please fill days and travelers!");
                return;
            }

            let total = 0;
            const travelMode = document.getElementById("travelMode").value;
            const maxDist = Math.max(0, Number(document.getElementById("maxDist").value));
            const hotel = document.getElementById("hotel").value;
            const rooms = Math.max(0, Number(document.getElementById("rooms").value));
            const meals = document.getElementById("meals").value;
            const activities = document.getElementById("activities").value;
            const localTransport = document.getElementById("localTransport").value;
            const guide = document.getElementById("guide").value;
            const travelStyle = document.getElementById("travelStyle").value;
            const buffer = Math.max(0, Number(document.getElementById("buffer").value));

            // React Calculation Emulation
            total += days * travelers * 1200;

            if (travelMode === "bus") total += maxDist * 2 * travelers;
            if (travelMode === "train") total += maxDist * 4 * travelers;
            if (travelMode === "flight") total += maxDist * 10 * travelers;

            if (hotel === "standard") total += days * 1500 * rooms;
            if (hotel === "premium") total += days * 3000 * rooms;
            if (hotel === "luxury") total += days * 6000 * rooms;

            if (meals === "yes") total += days * travelers * 800;

            if (activities === "basic") total += 2000;
            if (activities === "adventure") total += 6000;
            if (activities === "premium") total += 10000;

            if (localTransport === "cab") total += days * 2000;
            if (localTransport === "bike") total += days * 800;

            if (guide === "yes") total += days * 1500;

            if (travelStyle === "budget") total *= 0.9;
            if (travelStyle === "luxury") total *= 1.3;

            if (buffer) total += (total * buffer) / 100;

            document.getElementById("totalCalculated").value = Math.round(total);
            
            // Build JS Object state equivalent to React location.state
            const formState = {
                days: document.getElementById("days").value,
                travelers: document.getElementById("travelers").value,
                destinationType: document.getElementById("destinationType").value,
                travelStyle: travelStyle,
                travelMode: travelMode,
                hotel: hotel,
                rooms: document.getElementById("rooms").value,
                meals: meals,
                foodPreference: document.getElementById("foodPreference").value,
                activities: activities,
                localTransport: localTransport,
                guide: guide,
                maxDist: document.getElementById("maxDist").value,
                buffer: document.getElementById("buffer").value
            };
            document.getElementById("formState").value = JSON.stringify(formState);

            document.getElementById("budgetForm").submit();
        }
    </script>
}
